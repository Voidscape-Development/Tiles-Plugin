/*
 * Vortex - the noise, the phases and the colour behind
 * vortex_transition.effect, which includes this file.
 *
 * Kept apart from the effect so that test/test-vortex.cpp can compile this
 * same file as C++ (see test/hlsl.hpp) and check what the shader actually
 * runs, rather than a copy of it. It reads the effect's uniforms but declares
 * none of them, and samples no textures, which is what keeps it compilable in
 * both places.
 */

#define TAU 6.2831853

/* Angular cells around the portal rim. Integral, and stays integral as the
 * octaves double it, so the fibres meet cleanly where the circle closes. */
#define FIBRES 96.0

#define MIX_ARMS   0
#define MIX_RADIAL 1
#define MIX_BANDS  2

/* A single octave of value noise spends most of its time near its own mean, so
 * the palette selector is widened about the midpoint. Without this the first
 * and last colour of a mix would only ever appear as a tint. */
#define MIX_GAIN 1.7

/* How much of a banded step is spent crossing to the next colour. Small enough
 * that the bands read as flat, wide enough that the edge is not a stair. */
#define BAND_EDGE 0.12

/* ------------------------------------------------------------------ */
/* noise                                                              */
/* ------------------------------------------------------------------ */

float hash1(float2 p)
{
	float3 q = frac(float3(p.x, p.y, p.x) * float3(0.1031, 0.1030, 0.0973) + 7.13);
	q += dot(q, float3(q.y, q.z, q.x) + 33.33);
	return frac((q.x + q.y) * q.z);
}

/* Value noise whose lattice wraps along x with period per. */
float vnoise_p(float2 p, float per)
{
	float2 i = floor(p);
	float2 f = p - i;
	float x0 = i.x - per * floor(i.x / per);
	float x1 = i.x + 1.0 - per * floor((i.x + 1.0) / per);
	float a, b, c, d;

	f = f * f * (3.0 - 2.0 * f);

	a = hash1(float2(x0, i.y));
	b = hash1(float2(x1, i.y));
	c = hash1(float2(x0, i.y + 1.0));
	d = hash1(float2(x1, i.y + 1.0));

	return lerp(lerp(a, b, f.x), lerp(c, d, f.x), f.y);
}

/* Four octaves, unrolled. The period doubles with the frequency so every
 * octave closes at the same place the circle does. */
float fbm_p(float2 p, float per)
{
	float v = 0.5 * vnoise_p(p, per);

	p *= 2.0;
	per *= 2.0;
	v += 0.25 * vnoise_p(p, per);

	p *= 2.0;
	per *= 2.0;
	v += 0.125 * vnoise_p(p, per);

	p *= 2.0;
	per *= 2.0;
	v += 0.0625 * vnoise_p(p, per);

	return v / 0.9375;
}

float vnoise(float2 p)
{
	float2 i = floor(p);
	float2 f = p - i;
	float a, b, c, d;

	f = f * f * (3.0 - 2.0 * f);

	a = hash1(i);
	b = hash1(i + float2(1.0, 0.0));
	c = hash1(i + float2(0.0, 1.0));
	d = hash1(i + float2(1.0, 1.0));

	return lerp(lerp(a, b, f.x), lerp(c, d, f.x), f.y);
}

float fbm(float2 p)
{
	float v = 0.5 * vnoise(p);

	p *= 2.0;
	v += 0.25 * vnoise(p);

	p *= 2.0;
	v += 0.125 * vnoise(p);

	p *= 2.0;
	v += 0.0625 * vnoise(p);

	return v / 0.9375;
}

/* ------------------------------------------------------------------ */
/* body palette                                                       */
/* ------------------------------------------------------------------ */

/*
 * The body of the vortex can hold up to four colours. body_span is the count
 * minus one and t runs 0..body_span, so entry i is at t = i.
 *
 * Three unconditional lerps rather than an indexed lookup: each one only starts
 * once the one before it has run out, so a whole t lands exactly on that entry
 * and a fractional one is a two-colour blend of its neighbours - no dynamic
 * indexing, and nothing to go wrong on a driver that dislikes it. The unused
 * tail of the palette is unreachable rather than merely unset: with a single
 * colour body_span is 0, every saturate() below is 0 and this is color_deep
 * exactly, bit for bit what the effect did before the palette existed.
 */
float3 body_colour(float t)
{
	float3 c = lerp(color_deep.rgb, color_deep2.rgb, saturate(t));

	c = lerp(c, color_deep3.rgb, saturate(t - 1.0));
	c = lerp(c, color_deep4.rgb, saturate(t - 2.0));

	return c;
}

/* A single octave of value noise widened so its colours reach the ends of
 * the palette; see MIX_GAIN. */
float mix_gain(float n)
{
	return saturate((n - 0.5) * MIX_GAIN + 0.5);
}

/*
 * A 0..1 selector as a palette position, 0..body_span.
 *
 * Bands snap to whole entries, with a thin ramp across the boundary: the
 * colours stay flat, but the edge between them is filtered rather than
 * aliasing along a spiral. Written out rather than reached through
 * smoothstep(), which no effect in OBS itself uses.
 */
float body_position(float m)
{
	float t = m * body_span;

	if (color_mix == MIX_BANDS) {
		float base = floor(t);
		float edge = saturate((t - base - (1.0 - BAND_EDGE)) / BAND_EDGE);

		t = base + edge * edge * (3.0 - 2.0 * edge);
	}

	return t;
}

/*
 * Where in the palette a pixel sits, 0..body_span.
 *
 * q is the log-polar coordinate the arms themselves are drawn from, so it
 * already carries the twist and the spin: colour patches lie along the arms and
 * travel with them instead of sitting still while the vortex turns underneath.
 * One octave is enough - the palette wants broad regions, not detail - and it
 * is sampled on the same wrapped lattice as the arms, so a patch is about an
 * arm across and the ring closes with no seam.
 */
float body_mix(float2 q, float r)
{
	if (color_mix == MIX_RADIAL)
		return body_position(saturate(r / reach));

	return body_position(mix_gain(vnoise_p(float2(q.x, q.y * 0.35 + 4.9), arms)));
}

/* ------------------------------------------------------------------ */
/* phases                                                             */
/* ------------------------------------------------------------------ */

/* Two bands: broad lobes for the shape of the tear, fine chatter for the
 * fibres along it. Both wrap, and the result stays inside 0..1, which is what
 * iris_radius() and the bound in PSVortex() both lean on. */
float iris_edge(float ang)
{
	float lobes = fbm_p(float2(ang * FIBRES / TAU, 3.7), FIBRES);
	float chatter = fbm_p(float2(ang * FIBRES * 4.0 / TAU, 9.1), FIBRES * 4.0);

	return saturate(lobes * 0.62 + chatter * 0.38);
}

/*
 * The portal boundary, in field units. The fringe is subtracted from an
 * oversized radius rather than added to a nominal one, so the extremes stay
 * exact whatever the noise does: at k = 0 the radius is zero and nothing is
 * covered, at k = 1 it is at or above the reach and everything is. Without that
 * the transition would either flash a sliver of the outgoing scene at the
 * corners or start with a speck of portal already showing.
 *
 * The fringe is scaled by k along with the radius. An unscaled one is a fixed
 * width in field units, which is a reasonable fray on a portal that has grown
 * to fill the canvas and a sea urchin on one that is still a few pixels wide.
 * Scaling it keeps the tear the same fraction of the rim the whole way out.
 *
 * Because iris_edge() is bounded to 0..1, the result is bounded too:
 *
 *     k * reach  <=  iris_radius(ang, k)  <=  k * reach * (1 + fringe)
 *
 * for every angle. PSVortex() uses the upper bound to throw away the pixels
 * outside the portal without evaluating the noise at all.
 */
float iris_radius(float ang, float k)
{
	return k * reach * (1.0 + fringe) - k * fringe * reach * iris_edge(ang);
}

/*
 * How much of the incoming scene has come back, 0..1.
 *
 * The threshold is driven by the noise and by the radius together, so the
 * reveal erodes outwards from the origin instead of fading in everywhere at
 * once, and the noise is warped by a second fBm so the edges tendril the way
 * smoke does rather than breaking up into blobs.
 *
 * Like iris_radius() the ends are exact by construction: field never leaves
 * 0..1, so k = 0 gives 0 and k = 1 gives 1 for every pixel. The noise term is
 * bounded as well, which is what lets PSVortex() settle the two ends of the
 * threshold from the radius alone:
 *
 *     0.45 * saturate(r / reach)  <=  field  <=  0.55 + 0.45 * saturate(r / reach)
 */
float reveal_amount(float2 p, float r, float k)
{
	float2 q = p * smoke_scale;
	float2 w = float2(fbm(q + 11.3), fbm(q - 7.1)) - 0.5;
	float n = fbm(q + w * 1.8);
	float field = saturate(n * 0.55 + saturate(r / reach) * 0.45);
	float soft = max(smoke_soft, 0.02);

	return saturate((k * (1.0 + 2.0 * soft) - soft - field) / soft);
}

/* ------------------------------------------------------------------ */
/* the vortex itself                                                  */
/* ------------------------------------------------------------------ */

float3 vortex_colour(float2 p, float r, float ang, float rim)
{
	float lr = log(max(r, 0.02));
	float s = ang + twist * lr - spin * TAU * progress;
	float2 q = float2(s * arms / TAU, lr * detail - spin * progress);
	float n = fbm_p(q, arms);
	float ridge = 1.0 - abs(n * 2.0 - 1.0);

	/* fBm crowds around its own mean, so the raw ridge is a broad smear.
	 * Rescaling the top half of the range to 0..1 before squaring it is what
	 * turns the arms into filaments with dark lanes between them instead of
	 * one soft purple wash. */
	float arm = saturate((ridge - 0.5) * 2.0);
	float radial = saturate(1.0 - r / (reach * 1.15));
	float e = arm * arm * 1.8 * radial * radial;
	float3 body = color_deep.rgb;
	float3 col;

	/* the hot point at the eye of the spiral */
	e += 1.6 / (1.0 + r * r * 260.0);

	/* anamorphic streak across it, the one deliberately lens-like flourish */
	e += 0.7 * exp(-abs(p.y) * 70.0) * exp(-r * 2.0);

	e *= intensity * glow;

	/*
	 * The rim is added after the envelope rather than through it. The
	 * envelope is squared on the way up so the spiral does not bloom before
	 * the portal has anything to bloom inside, but the rim is brightest
	 * exactly when the portal is small, and running it through the same curve
	 * put the light where the effect does not need it and took it away from
	 * where it does.
	 *
	 * iris_k is that same rise: it is pinned at 1 once the portal has opened,
	 * and rim is 0 from then on, so the two agree everywhere it matters.
	 */
	e += rim * intensity * iris_k;

	/* A single colour skips the selector outright, so nothing below is paid
	 * for by anyone who has not asked for a mix. */
	if (body_span > 0.0)
		body = body_colour(body_mix(q, r));

	/* dim energy is the body colour, hot energy blows out towards the core
	 * colour - one ramp doing the work of a bloom pass. core_level is where
	 * that starts and core_width is how long it takes, so the pair set how
	 * far the core floods the arms when the vortex flashes. */
	col = body * e;
	return lerp(col, color_bright.rgb, saturate((e - core_level) / max(core_width, 0.0001)));
}

/* ------------------------------------------------------------------ */
/* scene sampling                                                     */
/* ------------------------------------------------------------------ */

/*
 * How much of the pixel at p - r from the origin, at angle ang - the vortex
 * covers, in x, and in y the portal's radius at that angle while it is opening,
 * which the rim light is drawn from; 0 when it was not needed.
 */
float2 vortex_cover(float2 p, float r, float ang)
{
	float aa = 1.5 / unit_px;

	/*
	 * Coverage first, and as much of it as possible from the radius alone.
	 * The generated light and the scene underneath it are both skippable -
	 * one is multiplied away where coverage is 0, the other where it is 1 -
	 * and so is the noise that decides coverage itself, wherever the bounds
	 * on that noise already settle the answer.
	 *
	 * Every test below is on the radius alone, so neighbouring pixels agree
	 * and the branches are worth taking: what they carve the canvas into is
	 * a disc, a ring and the band between them, not a per-pixel scatter.
	 */
	if (progress < open_end) {
		/*
		 * Opening. iris_radius() never exceeds this bound, so anything
		 * past it is outside the portal whatever the rim noise is
		 * doing - and that is most of the canvas for most of the phase.
		 */
		float outer = iris_k * reach * (1.0 + fringe);
		float radius;

		if (r >= outer + 0.5 * aa)
			return float2(0.0, 0.0);

		radius = iris_radius(ang, iris_k);
		return float2(saturate((radius - r) / aa + 0.5), radius);
	}

	if (progress < reveal_start) {
		/*
		 * The hold, and the cheapest phase there is: at k = 1 the portal
		 * boundary is at or beyond the reach for every angle, and the
		 * reach is measured to the furthest corner of the canvas, so
		 * every pixel is inside it. Coverage is 1 by construction, which
		 * leaves neither rim noise nor a scene to sample - the two most
		 * expensive things the shader can do, both of them dead weight
		 * across the whole canvas for the whole of the phase.
		 *
		 * This is also what the scene swap in the middle of the hold
		 * rests on, and it is now exact. Working coverage out from the
		 * noise left one pixel able to dip to 0.5: the furthest corner,
		 * at an angle where the rim noise peaked at 1, which is the only
		 * place the cut could ever have shown through.
		 */
		return float2(1.0, 0.0);
	}

	/*
	 * The reveal. The noise term in the threshold is bounded to 0..1, so
	 * with rr = saturate(r / reach) the field lies between 0.45 * rr and
	 * 0.55 + 0.45 * rr, and both ends of the reveal can be settled without
	 * the three fBms the smoke costs. The reveal erodes outwards, so what
	 * those bounds carve out is the inner disc that is already fully back
	 * and the outer ring that has not started; only the tendrils in between
	 * are evaluated.
	 */
	float soft = max(smoke_soft, 0.02);
	float rr = saturate(r / reach);
	float spent = reveal_k * (1.0 + 2.0 * soft) - 2.0 * soft;

	if (0.55 + 0.45 * rr <= spent)
		return float2(0.0, 0.0);
	if (0.45 * rr >= spent + soft)
		return float2(1.0, 0.0);
	return float2(1.0 - reveal_amount(p, r, reveal_k), 0.0);
}

/*
 * Optional swirl. The reference this was modelled on leaves the scenes flat
 * and only composites over them, so this is off by default; when it is on the
 * outgoing scene screws down into the origin and the incoming one unwinds back
 * out of it. Both ends are identity - the angle is handed in at zero on the
 * first and last frame - so the transition still starts and finishes on an
 * untouched frame.
 */
float2 swirl_uv(float2 p, float r, float amt, float pull)
{
	float falloff = saturate(1.0 - r / (reach * 1.2));
	float a = amt * falloff * falloff;
	float ca = cos(a);
	float sa = sin(a);
	float2 q = float2(p.x * ca - p.y * sa, p.x * sa + p.y * ca) * pull;

	return (q * unit_px + origin_px) / canvas;
}
