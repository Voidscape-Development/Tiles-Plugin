/*
 * Tiles - tiling scene transition for OBS Studio
 *
 * Every shape here tiles the plane edge to edge, so at full scale the tiles
 * leave no uncovered pixel:
 *
 *   square    - unit square lattice
 *   hexagon   - Voronoi cells of a triangular lattice (pointy-top hexagons)
 *   triangle  - equilateral triangles, two per lattice rhombus
 *   diamond   - a triangle joined to its mirror image along the base, so one
 *               diamond per pair of triangles, on the same lattice
 *   brick     - squat rectangles, every other row slid half a brick along
 *   octagon   - regular octagons on a square lattice, with the square each
 *               lattice corner is left standing on its point as a tile too
 *   cairo     - the Cairo pentagon, four to a turn around each four-fold point
 *   mosaic    - squares that quarter themselves, twice, on their own hash, so
 *               the tiling mixes three tile sizes
 *   shatter   - the Voronoi cells of a jittered lattice of seeds
 *   circle    - circumscribed circles on the hexagonal lattice; they overshoot
 *               the cell and overlap their neighbours to close the gaps
 *
 * Every tile grows by scaling about its own centre, so the metric of each
 * shape is a gauge: homogeneous, 0 at the centre and 1 on the boundary. That
 * is what makes coverage track the square of the scale for all of them, mixed
 * tile sizes included, and what lets a shape be anything star shaped about its
 * centre rather than only the regular polygons that tile on their own.
 *
 * NOTE: the lattice and coverage math is mirrored in test/test-tiling.c.
 * Keep the two in sync when changing shape_metric()/resolve_tile().
 */

uniform float4x4 ViewProj;
uniform texture2d a_tex;
uniform texture2d b_tex;

uniform float2 canvas;     /* render target size, pixels */
uniform float2 origin_px;  /* tiling origin, pixels */
uniform float2 grid_rot;   /* cos/sin of the lattice rotation */
uniform float2 dir_vec;    /* sweep axis, unit length */
uniform float2 dir_range;  /* x: projection minimum, y: projection span */

uniform float4 color_a;    /* gradient start */
uniform float4 color_b;    /* gradient end */

uniform float progress;    /* transition time, 0..1; linear, see ease_order() */
uniform float tile_px;     /* lattice unit, pixels */
uniform float edge;        /* antialiasing width, metric units */
uniform float tile_dur;    /* per tile animation length, fraction of the sweep */
uniform float band;        /* wave band thickness, fraction of the sweep */
uniform float randomness;  /* 0 = ordered sweep, 1 = fully shuffled */
uniform float variation;   /* per tile brightness jitter */

uniform int easing;        /* 0 linear, 1 in-out, 2 out; shapes the launch order */
uniform int mode;          /* 0 cover, 1 keyhole, 2 wave, 3 crop, 4 scale */
uniform int shape;         /* 0 square, 1 circle, 2 hexagon, 3 triangle, 4 diamond,
			      5 brick, 6 octagon, 7 cairo, 8 mosaic, 9 shatter */
uniform int direction;     /* 0 in-out, 1 out-in, 2 mirror-in, 3 mirror-out, 4 angle */

uniform bool invert;       /* keyhole: put the outgoing scene inside the tiles */
uniform bool reverse_exit; /* cover: tiles leave in reverse order */
uniform bool b_tiles;      /* dissolve: incoming scene arrives as tiles too */

sampler_state textureSampler {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv = v_in.uv;
	return vert_out;
}

/* ------------------------------------------------------------------ */
/* hashes                                                             */
/* ------------------------------------------------------------------ */

float hash21(float2 p)
{
	float2 h = frac(p * float2(127.1, 311.7));
	h += dot(h, h + 47.31);
	return frac(h.x * h.y);
}

/* Two uncorrelated values from one cell, for the shatter jitter. */
float2 hash22(float2 p)
{
	return float2(hash21(p), hash21(p + 19.73));
}

/* ------------------------------------------------------------------ */
/* lattice                                                            */
/* ------------------------------------------------------------------ */

float2 to_lattice(float2 px)
{
	float2 d = px - origin_px;
	return float2(d.x * grid_rot.x + d.y * grid_rot.y, d.y * grid_rot.x - d.x * grid_rot.y) / tile_px;
}

float2 from_lattice(float2 q)
{
	float2 r = q * tile_px;
	return float2(r.x * grid_rot.x - r.y * grid_rot.y, r.x * grid_rot.y + r.y * grid_rot.x) + origin_px;
}

/* Nearest centre of the triangular lattice: the plane split into hexagons. */
float2 hex_centre(float2 q)
{
	float2 s = float2(1.0, 1.7320508);
	float2 o = float2(0.5, 0.8660254);
	float2 c1 = (floor(q / s) + 0.5) * s;
	float2 c2 = (floor((q - o) / s) + 0.5) * s + o;
	float2 d1 = q - c1;
	float2 d2 = q - c2;
	if (dot(d1, d1) < dot(d2, d2))
		return c1;
	return c2;
}

/* Seed of a shatter cell, jittered inside its own cell so the seed nearest a
 * pixel is always in the 3x3 block of cells around it. */
float2 shatter_seed(float2 cell)
{
	return cell + 0.5 + (hash22(cell) - 0.5) * 0.8;
}

/*
 * One half plane of a Voronoi cell, as a gauge: the neighbouring seed cuts the
 * owner's tile along the bisector between them, where this reads 1. Cells that
 * hold the owner's own seed cut nothing.
 *
 * Returns the gauge in x and, in y, how fast it climbs relative to a tile of
 * the usual size: the nearer the neighbour, the nearer its cut and the steeper
 * the climb, so a cell the seeds squeezed needs a narrower ramp than one they
 * left roomy.
 */
float2 shatter_cut(float2 local, float2 owner, float2 cell)
{
	float2 d = shatter_seed(cell) - owner;
	float dd = dot(d, d);

	if (dd < 1e-6)
		return float2(0.0, 0.0);
	return float2(2.0 * dot(local, d) / dd, 1.0 / sqrt(dd));
}

/*
 * Gauge of the Cairo pentagon about its own seed. Every one of its five edges
 * sits the same distance from the seed - the tiling is the Voronoi diagram of
 * the snub square tiling, and all of that tiling's edges are one length - so
 * the gauge is the largest of five half planes of equal weight.
 */
float cairo_gauge(float2 x)
{
	float m = x.y;

	m = max(m, x.x * 0.8660254 + x.y * 0.5);
	m = max(m, x.x * 0.5 - x.y * 0.8660254);
	m = max(m, -x.x * 0.5 - x.y * 0.8660254);
	m = max(m, -x.x * 0.8660254 + x.y * 0.5);
	return m * 2.7320508;
}

float octagon_metric(float2 local)
{
	float2 p = abs(local);
	return max(max(p.x, p.y) * 2.0, (p.x + p.y) * 1.4142136);
}

/*
 * Distance to the tile edge, normalised: 0 at the tile centre, 1 on the tile
 * boundary. A tile scaled by s about its centre covers the pixel when the
 * metric is <= s, so s = 1 is exactly full coverage of the cell.
 */
float shape_metric(float2 local)
{
	if (shape == 0)
		return max(abs(local.x), abs(local.y)) * 2.0;
	if (shape == 1)
		return length(local) * 1.7320508; /* 1 / circumradius */
	if (shape == 4)
		/* half width 0.5 across, half height sqrt(3)/2 down */
		return abs(local.x) * 2.0 + abs(local.y) * 1.1547005;
	if (shape == 5)
		/* twice as wide as it is tall */
		return max(abs(local.x) * 2.0, abs(local.y) * 4.0);

	float2 p = abs(local);
	return max(p.x, p.x * 0.5 + p.y * 0.8660254) * 2.0;
}

/* Keeps whichever of two shatter seeds is nearer the pixel. */
float2 shatter_nearer(float2 q, float2 best, float2 cell)
{
	float2 s = shatter_seed(cell);

	if (dot(q - s, q - s) < dot(q - best, q - best))
		return s;
	return best;
}

struct Cell {
	float2 centre; /* lattice space */
	float metric;
	float aa; /* coverage ramp of this cell, relative to the shape's own */
};

Cell resolve_tile(float2 q)
{
	Cell cell;

	/* tilings whose cells all match take the shape's ramp as it comes */
	cell.aa = 1.0;

	if (shape == 0) {
		cell.centre = floor(q) + 0.5;
		cell.metric = shape_metric(q - cell.centre);
	} else if (shape == 3) {
		/* skew onto the (1,0) / (0.5, sqrt(3)/2) basis */
		float sy = q.y / 0.8660254;
		float sx = q.x - 0.5 * sy;
		float2 ic = floor(float2(sx, sy));
		float2 f = float2(sx, sy) - ic;
		float3 bary;
		float2 cs;

		if (f.x + f.y < 1.0) {
			bary = float3(1.0 - f.x - f.y, f.x, f.y);
			cs = ic + 0.3333333;
		} else {
			bary = float3(1.0 - f.y, 1.0 - f.x, f.x + f.y - 1.0);
			cs = ic + 0.6666667;
		}

		/* scaling about the centroid moves every barycentric equally */
		cell.metric = 1.0 - 3.0 * min(bary.x, min(bary.y, bary.z));
		cell.centre = float2(cs.x + 0.5 * cs.y, 0.8660254 * cs.y);
	} else if (shape == 4) {
		/*
		 * A triangle and the one mirrored under it, taken as a single
		 * tile. Shearing onto g = 2x + y / (sqrt(3)/2) and
		 * h = 2x - y / (sqrt(3)/2) turns the diamonds into axis aligned
		 * squares of side 2, so the cell is found the same cheap,
		 * branch free way the square one is.
		 */
		float2 gh = float2(q.x * 2.0 + q.y * 1.1547005, q.x * 2.0 - q.y * 1.1547005);
		float2 c = (floor(gh * 0.5) + 0.5) * 2.0;

		cell.centre = float2((c.x + c.y) * 0.25, (c.x - c.y) * 0.4330127);
		cell.metric = shape_metric(q - cell.centre);
	} else if (shape == 5) {
		/* running bond: every other row of bricks slides half a brick */
		float row = floor(q.y * 2.0);
		float off = 0.5 * (row - 2.0 * floor(row * 0.5));
		float col = floor(q.x - off);

		cell.centre = float2(col + 0.5 + off, (row + 0.5) * 0.5);
		cell.metric = shape_metric(q - cell.centre);
	} else if (shape == 6) {
		/*
		 * Regular octagons on a square lattice. They cannot close the
		 * plane on their own; what they leave at each lattice corner is
		 * a square standing on its point, and that is a tile too.
		 */
		float2 oc = floor(q) + 0.5;
		float mo = octagon_metric(q - oc);

		if (mo <= 1.0) {
			cell.centre = oc;
			cell.metric = mo;
		} else {
			float2 sc = floor(q + 0.5);
			float2 d = abs(q - sc);

			cell.centre = sc;
			cell.metric = (d.x + d.y) * 3.4142136;
			/* the corner squares are the smaller tile, so their
			 * metric climbs faster and their ramp has to widen */
			cell.aa = 2.4142136;
		}
	} else if (shape == 7) {
		/*
		 * Cairo: one pentagon per edge of a square lattice of four-fold
		 * vertices, pinwheeled around each vertex. On an even cell the
		 * two pentagons standing on the horizontal edges fill most of
		 * it and the two on the vertical edges poke their apexes in; an
		 * odd cell is the same pattern turned a quarter turn.
		 */
		float2 ic = floor(q);
		float2 f = q - ic;
		float2 g = f;
		float odd = 0.0;
		float2 s0 = float2(0.5, 0.1339746);  /* body up, apex down */
		float2 s1 = float2(0.5, 0.8660254);  /* body down, apex up */
		float2 s2 = float2(-0.1339746, 0.5); /* body left, apex right */
		float2 s3 = float2(1.1339746, 0.5);  /* body right, apex left */
		float2 d2;
		float2 d3;
		float2 s = s0;
		float m1;
		float m2;
		float m3;
		float m;

		if (frac((ic.x + ic.y) * 0.5) > 0.25) {
			odd = 1.0;
			g = float2(f.y, 1.0 - f.x);
		}

		d2 = g - s2;
		d3 = g - s3;
		m = cairo_gauge(g - s0);
		m1 = cairo_gauge(s1 - g);
		m2 = cairo_gauge(float2(d2.y, -d2.x));
		m3 = cairo_gauge(float2(-d3.y, d3.x));

		/* the pixel's own pentagon is the only one that reads under 1 */
		if (m1 < m) {
			m = m1;
			s = s1;
		}
		if (m2 < m) {
			m = m2;
			s = s2;
		}
		if (m3 < m) {
			m = m3;
			s = s3;
		}

		if (odd > 0.5)
			cell.centre = ic + float2(1.0 - s.y, s.x);
		else
			cell.centre = ic + s;
		cell.metric = m;
	} else if (shape == 8) {
		/* squares that quarter themselves, twice, on their own hash */
		float2 o = floor(q);
		float sz = 1.0;

		if (hash21(o + sz * 0.5) < 0.5) {
			sz *= 0.5;
			o += clamp(floor((q - o) / sz), 0.0, 1.0) * sz;
		}
		if (hash21(o + sz * 0.5) < 0.5) {
			sz *= 0.5;
			o += clamp(floor((q - o) / sz), 0.0, 1.0) * sz;
		}

		cell.centre = o + sz * 0.5;
		cell.metric = max(abs(q.x - cell.centre.x), abs(q.y - cell.centre.y)) * 2.0 / sz;
		/* a quartered cell is half the size, so its metric climbs twice
		 * as fast over the same pixel and its ramp has to widen to match */
		cell.aa = 1.0 / sz;
	} else if (shape == 9) {
		/* shatter: the Voronoi cells of a jittered lattice of seeds */
		float2 b = floor(q);
		float2 o = shatter_seed(b);
		float2 oc;
		float2 local;
		float2 m;

		o = shatter_nearer(q, o, b + float2(-1.0, -1.0));
		o = shatter_nearer(q, o, b + float2(0.0, -1.0));
		o = shatter_nearer(q, o, b + float2(1.0, -1.0));
		o = shatter_nearer(q, o, b + float2(-1.0, 0.0));
		o = shatter_nearer(q, o, b + float2(1.0, 0.0));
		o = shatter_nearer(q, o, b + float2(-1.0, 1.0));
		o = shatter_nearer(q, o, b + float2(0.0, 1.0));
		o = shatter_nearer(q, o, b + float2(1.0, 1.0));

		/* the tile is whatever the seeds around the owner leave it */
		oc = floor(o);
		local = q - o;
		/* componentwise: the deepest cut is the metric, and the closest
		 * neighbour of the lot is the tile's steepest edge, which is
		 * the one its ramp has to be wide enough for */
		m = float2(0.0, 0.0);
		m = max(m, shatter_cut(local, o, oc + float2(-1.0, -1.0)));
		m = max(m, shatter_cut(local, o, oc + float2(0.0, -1.0)));
		m = max(m, shatter_cut(local, o, oc + float2(1.0, -1.0)));
		m = max(m, shatter_cut(local, o, oc + float2(-1.0, 0.0)));
		m = max(m, shatter_cut(local, o, oc + float2(1.0, 0.0)));
		m = max(m, shatter_cut(local, o, oc + float2(-1.0, 1.0)));
		m = max(m, shatter_cut(local, o, oc + float2(0.0, 1.0)));
		m = max(m, shatter_cut(local, o, oc + float2(1.0, 1.0)));

		cell.centre = o;
		cell.metric = m.x;
		cell.aa = m.y;
	} else {
		cell.centre = hex_centre(q);
		cell.metric = shape_metric(q - cell.centre);
	}

	return cell;
}

/* ------------------------------------------------------------------ */
/* sweep order                                                        */
/* ------------------------------------------------------------------ */

/*
 * Where this tile sits in the sweep, 0 (first) to 1 (last). The ranges are
 * normalised against the whole canvas as seen from the origin, so an offset
 * origin still finishes every tile inside the transition.
 */
float sweep_order(float2 centre_px)
{
	float2 d = centre_px - origin_px;

	if (direction == 0)
		return saturate(length(d) / dir_range.y);
	if (direction == 1)
		return 1.0 - saturate(length(d) / dir_range.y);

	float proj = dot(d, dir_vec);

	if (direction == 4)
		return saturate((proj - dir_range.x) / dir_range.y);

	float m = saturate(abs(proj) / dir_range.y);

	if (direction == 3)
		return m;
	return 1.0 - m;
}

/* Antialiased coverage of a tile scaled by s. Exact at both extremes so a
 * finished sweep leaves no seams and a spent tile leaves no speck. The ramp is
 * measured in metric units, so a tiling whose cells differ in size scales it
 * per cell to keep the edge about a pixel wide whatever the tile. */
float tile_coverage(float metric, float s, float aa)
{
	if (s <= 0.0)
		return 0.0;
	if (s >= 1.0)
		return 1.0;
	return saturate((s - metric) / (edge * aa) + 1.0);
}

/*
 * Eases the order tiles launch in, rather than the transition clock.
 *
 * The easing used to be applied to progress itself, which warped both when a
 * tile started and how fast it grew. Tiles in the middle of the sweep landed
 * on the fast part of the curve and had to finish their whole animation in
 * noticeably fewer frames than tiles at either end - the same tile_dur buying
 * three frames of growth in one place and five in another. That unevenness is
 * what reads as clunky, and it gets worse the longer tile_dur is, because
 * there is more per-tile animation to compress.
 *
 * Easing the launch order instead leaves the clock linear, so every tile grows
 * at the same rate over the same number of frames, while the wavefront still
 * accelerates away and settles the way the easing asks. The curve maps 0 to 0
 * and 1 to 1, so the first tile still launches at the start and the last one
 * still finishes at the end.
 */
float ease_order(float d)
{
	if (easing == 1)
		return d * d * (3.0 - 2.0 * d);
	if (easing == 2)
		return 1.0 - (1.0 - d) * (1.0 - d);
	return d;
}

/* ------------------------------------------------------------------ */
/* per tile evaluation                                                */
/* ------------------------------------------------------------------ */

struct Tile {
	float2 centre_px;
	float metric;
	float aa;
	float cov;
	float s;    /* scale of the shape, 0..1 */
	float d;    /* sweep order */
	float h;    /* per tile hash */
	float on_b; /* 1 once this tile hides the switch to the incoming scene */
};

Tile eval_tile(float2 centre_lat, float metric, float aa)
{
	Tile tile;

	tile.centre_px = from_lattice(centre_lat);
	tile.metric = metric;
	tile.aa = aa;
	tile.h = hash21(centre_lat);
	tile.d = lerp(sweep_order(tile.centre_px), tile.h, randomness);
	tile.on_b = 0.0;

	if (mode == 0) {
		/* cover: build up over the first half, break up over the second */
		float half_t = progress * 2.0;
		float d = tile.d;

		if (progress >= 0.5) {
			half_t = (progress - 0.5) * 2.0;
			tile.on_b = 1.0;
			if (reverse_exit)
				d = 1.0 - d;
		}

		/* eased after any reversal, so the exit sweep eases the way it
		 * travels rather than running the curve backwards */
		float p = saturate((half_t - ease_order(d) * (1.0 - tile_dur)) / tile_dur);
		tile.s = (progress >= 0.5) ? 1.0 - p : p;
	} else if (mode == 2) {
		/* wave: grow, hold for the band, shrink again */
		float start = ease_order(tile.d) * (1.0 - 2.0 * tile_dur - band);
		float grow = saturate((progress - start) / tile_dur);
		float shrink = saturate((progress - start - tile_dur - band) / tile_dur);

		tile.s = grow - shrink;
		tile.on_b = (shrink > 0.0) ? 1.0 : 0.0;
	} else {
		float p = saturate((progress - ease_order(tile.d) * (1.0 - tile_dur)) / tile_dur);

		/* keyhole grows a window into the incoming scene, the dissolves
		 * and inverted keyhole shrink the outgoing one away */
		tile.s = (mode == 1 && !invert) ? p : 1.0 - p;
	}

	tile.cov = tile_coverage(metric, tile.s, aa);
	return tile;
}

/* Circles reach past their own cell, so a pixel can belong to a neighbour. */
Tile best_tile(float2 q)
{
	Cell cell = resolve_tile(q);
	Tile best = eval_tile(cell.centre, cell.metric, cell.aa);

	if (shape == 1) {
		float2 c;
		Tile n;

		c = cell.centre + float2(1.0, 0.0);
		n = eval_tile(c, shape_metric(q - c), 1.0);
		if (n.cov > best.cov)
			best = n;

		c = cell.centre + float2(-1.0, 0.0);
		n = eval_tile(c, shape_metric(q - c), 1.0);
		if (n.cov > best.cov)
			best = n;

		c = cell.centre + float2(0.5, 0.8660254);
		n = eval_tile(c, shape_metric(q - c), 1.0);
		if (n.cov > best.cov)
			best = n;

		c = cell.centre + float2(-0.5, 0.8660254);
		n = eval_tile(c, shape_metric(q - c), 1.0);
		if (n.cov > best.cov)
			best = n;

		c = cell.centre + float2(0.5, -0.8660254);
		n = eval_tile(c, shape_metric(q - c), 1.0);
		if (n.cov > best.cov)
			best = n;

		c = cell.centre + float2(-0.5, -0.8660254);
		n = eval_tile(c, shape_metric(q - c), 1.0);
		if (n.cov > best.cov)
			best = n;
	}

	return best;
}

float4 tile_colour(Tile tile)
{
	float4 c = lerp(color_a, color_b, tile.d);
	c.rgb *= 1.0 + (tile.h * 2.0 - 1.0) * variation;
	return c;
}

/* ------------------------------------------------------------------ */

float4 PSTiles(VertData v_in) : TARGET
{
	float2 uv = v_in.uv;
	Tile tile = best_tile(to_lattice(uv * canvas));

	if (mode == 0 || mode == 2) {
		float4 scene = (tile.on_b > 0.5) ? b_tex.Sample(textureSampler, uv)
						 : a_tex.Sample(textureSampler, uv);
		return lerp(scene, tile_colour(tile), tile.cov);
	}

	if (mode == 1) {
		float4 a_col = a_tex.Sample(textureSampler, uv);
		float4 b_col = b_tex.Sample(textureSampler, uv);
		if (invert)
			return lerp(b_col, a_col, tile.cov);
		return lerp(a_col, b_col, tile.cov);
	}

	/* dissolves: the outgoing scene is cropped or squeezed into the tile */
	float2 centre_uv = tile.centre_px / canvas;

	float4 base = b_tex.Sample(textureSampler, uv);

	if (b_tiles) {
		float grow = 1.0 - tile.s;
		float2 uv_b = uv;
		if (mode == 4)
			uv_b = centre_uv + (uv - centre_uv) / max(grow, 0.0001);

		base = lerp(tile_colour(tile), b_tex.Sample(textureSampler, uv_b),
			    tile_coverage(tile.metric, grow, tile.aa));
	}

	/*
	 * A tile with no coverage shows none of the outgoing scene, so the
	 * sample below is multiplied away. Returning early skips it.
	 *
	 * This is worth a branch because the sample is the expensive one. Scale
	 * Shrink divides by the tile scale, so as a tile finishes shrinking the
	 * divisor falls to the 0.0001 floor and the coordinate is magnified by
	 * up to 10000x: neighbouring pixels then read texels thousands apart and
	 * every fetch misses the texture cache. Spent tiles are exactly the ones
	 * pinned at that floor, and they are most of the canvas by the end of the
	 * sweep, so the worst case ran over the largest area in the closing
	 * frames. Coverage is zero across a whole spent tile, so the branch is
	 * coherent rather than pixel by pixel.
	 *
	 * SampleLevel, not Sample: the branch only holds if the fetch needs no
	 * gradients, otherwise it gets flattened back into an unconditional
	 * sample. Both scenes arrive as canvas sized render targets with no mip
	 * chain, so level 0 is the level Sample was already resolving to.
	 */
	if (tile.cov <= 0.0)
		return base;

	float2 uv_a = uv;
	if (mode == 4)
		uv_a = centre_uv + (uv - centre_uv) / max(tile.s, 0.0001);

	return lerp(base, a_tex.SampleLevel(textureSampler, uv_a, 0.0), tile.cov);
}

technique Tiles
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader = PSTiles(v_in);
	}
}
